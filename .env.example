# Copy to .env (or set these in Hostinger > Node.js app > Environment variables)
NODE_ENV=production
PORT=3000
SITE_URL=https://waycupchai.com

# REQUIRED: long random string. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Admin login for /admin (created on first run)
ADMIN_EMAIL=admin@waycupchai.com
ADMIN_PASSWORD=ChangeThisNow!123

# Where JSON data is stored. Keep it OUTSIDE the deployed folder so redeploys don't wipe orders.
# e.g. /home/uXXXX/waycupchai-data
DATA_DIR=./server/data

# Store settings
FREE_SHIPPING_MIN=450
SHIPPING_FEE=49
WHATSAPP_NUMBER=918639450206
STORE_PHONE=+91 8639450206
STORE_PHONE_2=+91 70221 55609
STORE_EMAIL=hello@waycupchai.com

# Optional: Razorpay online payments (leave blank to offer Cash on Delivery only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: email notifications (order confirmations / enquiries). Use Hostinger email SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=hello@waycupchai.com
